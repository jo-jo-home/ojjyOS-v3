# Build outputs
build/
*.img
*.vdi
*.efi
*.o
*.obj
*.lib
*.d
kernel.bin

# Generated files
# Host tools are built from tools/*.c by tools/Makefile (scripts/mkfs.sh)
tools/mkojfs
tools/mkicon
tools/mkwallpaper
tools/mkarray
kernel/src/fs/system_fs.h
sysroot/System/Programs/*.elf

# OS junk
.Rhistory
.DS_Store
*.swp
*~
__pycache__/
*.pyc

# Numbered duplicates created by macOS/iCloud sync of build outputs
* [0-9].bin
* [0-9].o
* [0-9].d
* [0-9].efi
* [0-9].obj

# Apple wallpapers downloaded for personal use - never commit (copyright Apple)
wallpapers/local/

# Local AI session exports (personal, large)
*-custom-kernel.json
